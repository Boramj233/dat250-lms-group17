{
  "realm": "lms",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "spring",
      "name": "Local LMS backend",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8080", "http://localhost:5173"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    }
  ],
  "users": [
    {
      "username": "teacher",
      "enabled": true,
      "emailVerified": true,
      "email": "teacher@example.com",
      "firstName": "Demo",
      "lastName": "Teacher",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    },
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "email": "student1@example.com",
      "firstName": "Demo",
      "lastName": "Student One",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    },
    {
      "username": "student2",
      "enabled": true,
      "emailVerified": true,
      "email": "student2@example.com",
      "firstName": "Demo",
      "lastName": "Student Two",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    }
  ]
}
