{
  "realm": "lms",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@lms.localhost",
    "fromDisplayName": "DAT250 LMS",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "spring",
      "name": "LMS backend (Spring Boot OAuth 2.0 client)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/##http://localhost:5173/"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "protocolMappers": [
        {
          "name": "lms-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lms-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "lms-cli",
      "name": "Third-party API clients (public: authorization code + PKCE, device flow)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1/*", "http://localhost/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "protocolMappers": [
        {
          "name": "lms-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "lms-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    },
    {
      "username": "teacher",
      "enabled": true,
      "emailVerified": true,
      "email": "teacher@example.com",
      "firstName": "Demo",
      "lastName": "Teacher",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    },
    {
      "username": "student1",
      "enabled": true,
      "emailVerified": true,
      "email": "student1@example.com",
      "firstName": "Demo",
      "lastName": "Student One",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    },
    {
      "username": "student2",
      "enabled": true,
      "emailVerified": true,
      "email": "student2@example.com",
      "firstName": "Demo",
      "lastName": "Student Two",
      "credentials": [{"type": "password", "value": "${KEYCLOAK_DEMO_PASSWORD}", "temporary": false}]
    }
  ]
}
