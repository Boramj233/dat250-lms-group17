# Local development only. Copy to .env and replace these example values.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin
KEYCLOAK_DEMO_PASSWORD=change-me-local-demo
# Secret for the confidential Keycloak client "spring" (shared by Keycloak and the backend).
KEYCLOAK_CLIENT_SECRET=change-me-local-client
RABBITMQ_USERNAME=lms
RABBITMQ_PASSWORD=change-me-local-rabbit

# Private SeaweedFS bucket credentials. Replace examples; use letters, digits, _ or -.
LMS_STORAGE_ACCESS_KEY=change-me-local-storage-access
LMS_STORAGE_SECRET_KEY=change-me-local-storage-secret
# For backend bootRun outside Compose: export these values to enable file storage.
LMS_STORAGE_ENABLED=true
LMS_STORAGE_ENDPOINT=http://localhost:8333
# Single file limit and whole multipart request limit (includes headers/boundary).
# Increasing these also requires adjusting frontend/nginx.conf (currently 12M).
LMS_SUBMISSION_MAX_FILE_SIZE=10MB
LMS_SUBMISSION_MAX_REQUEST_SIZE=11MB
