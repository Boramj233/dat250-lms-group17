# Local development only. Copy to .env and replace these example values.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin
KEYCLOAK_DEMO_PASSWORD=change-me-local-demo
# Secret for the confidential Keycloak client "spring" (shared by Keycloak and the backend).
KEYCLOAK_CLIENT_SECRET=change-me-local-client
RABBITMQ_USERNAME=lms
RABBITMQ_PASSWORD=change-me-local-rabbit
