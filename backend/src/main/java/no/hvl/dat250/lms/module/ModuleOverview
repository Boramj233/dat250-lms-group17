//------------------------------------------ Overview example

Module 1: Introduction
    @Dependency = {}
    Content 1: Welcome Page
    Content 2: Introduction Quiz

Module 2: Your First CodeAssignment
    @Dependency = {Module 1}
    Content 1: Introduction To Python
    Content 2: Assignment - Hello_world.py

Module 3: Loops
    @Dependency = {Module 1, Module 2}
    Content 1: For Loops
    Content 2: While Loops

//------------------------------------------ Database example

modules:

id  |    title      | course_id
--------------------------------
1   | Introduction  | 1
2   | your First... | 1
3   | Loops         | 1

module_dependencies:

module_id   | required_module_id
--------------------------------
2           | 1
3           | 1
3           | 2


//------------------------------------------ Anti-Implementation

self-dependency:
Module 1 -> Module 1

circular-dependency:
Module 1 -> Module 2
Module 2 -> Module 1

cross-course-dependency:
Course 1:
    Module 1
Course 2:
    Module 1
    Module 2 -> Module 1 (Course 1)

//------------------------------------------ Visibility

Module visibility is student-specific.
Two students with different module progress should not have unlocked the same modules.