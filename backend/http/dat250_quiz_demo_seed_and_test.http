# DAT250 Group 17 LMS - Quiz demo data + read tests
# Use in VS Code REST Client / REST Client CE.
# Start backend first: ./gradlew :backend:bootRun
# IMPORTANT: Click 'Send Request' from TOP TO BOTTOM for the POST requests once.
# Each named request's response supplies the actual database ID to later requests.
# POST is NOT idempotent. Re-running a POST creates another record in file-backed H2.

@baseUrl = http://localhost:8080
@courseId = {{seedCourse.response.body.$.id}}
@javaModuleId = {{seedJavaModule.response.body.$.id}}
@springModuleId = {{seedSpringModule.response.body.$.id}}
@javaPageId = {{seedJavaPage.response.body.$.id}}
@quizId = {{seedQuiz.response.body.$.id}}
@springPageId = {{seedSpringPage.response.body.$.id}}

@assignmentCourseId = 1
@assignmentModuleId = 2

### 1. Create a demo course (expect 201)
# @name seedCourse
POST {{baseUrl}}/api/courses
Content-Type: application/json

{
  "title": "DAT250 Demo - Java and Spring",
  "description": "Local demo course for StaticPage and Quiz API integration testing.",
  "term": "AUTUMN",
  "year": 2026
}

### 2. Create Week 1 module (expect 201)
# @name seedJavaModule
POST {{baseUrl}}/api/courses/{{courseId}}/modules
Content-Type: application/json

{
  "title": "Week 1 - Java Basics",
  "position": 0
}

### 3. Create Week 2 module (expect 201)
# @name seedSpringModule
POST {{baseUrl}}/api/courses/{{courseId}}/modules
Content-Type: application/json

{
  "title": "Week 2 - Spring Boot",
  "position": 1
}

### 4. Create StaticPage in Week 1 (expect 201)
# @name seedJavaPage
POST {{baseUrl}}/api/courses/{{courseId}}/modules/{{javaModuleId}}/contents/pages
Content-Type: application/json

{
  "title": "Java Basics - Reading Notes",
  "position": 0,
  "body": "This lesson introduces classes, inheritance, interfaces, and access modifiers. After reading it, complete the Java Fundamentals Quiz in this module."
}

### 5. Create Quiz in Week 1 (expect 201)
# @name seedQuiz
POST {{baseUrl}}/api/courses/{{courseId}}/modules/{{javaModuleId}}/contents/quizzes
Content-Type: application/json

{
  "title": "Java Fundamentals Quiz",
  "position": 1,
  "maxAttempts": 2
}

### 6. Question 1: exactly ONE correct option (expect 201)
# @name seedQuestionOne
POST {{baseUrl}}/api/quizzes/{{quizId}}/questions
Content-Type: application/json

{
  "questionText": "Which keyword is used to extend a Java class?",
  "position": 0,
  "hint": "Think about how a subclass declares its parent class.",
  "options": [
    { "optionText": "extends", "position": 0, "correct": true },
    { "optionText": "implements", "position": 1, "correct": false },
    { "optionText": "import", "position": 2, "correct": false },
    { "optionText": "package", "position": 3, "correct": false }
  ]
}

### 7. Question 2: THREE correct options (expect 201)
# @name seedQuestionTwo
POST {{baseUrl}}/api/quizzes/{{quizId}}/questions
Content-Type: application/json

{
  "questionText": "Which of these are Java access modifiers?",
  "position": 1,
  "hint": "Consider which keywords control the accessibility of members.",
  "options": [
    { "optionText": "public", "position": 0, "correct": true },
    { "optionText": "private", "position": 1, "correct": true },
    { "optionText": "static", "position": 2, "correct": false },
    { "optionText": "protected", "position": 3, "correct": true }
  ]
}

### 8. Question 3: TWO correct options (expect 201)
# @name seedQuestionThree
POST {{baseUrl}}/api/quizzes/{{quizId}}/questions
Content-Type: application/json

{
  "questionText": "Which statements about Java are true?",
  "position": 2,
  "hint": "Think about the JVM and the structure of Java programs.",
  "options": [
    { "optionText": "Java source code can be compiled into bytecode.", "position": 0, "correct": true },
    { "optionText": "Java supports interfaces.", "position": 1, "correct": true },
    { "optionText": "Every Java class must declare a main method.", "position": 2, "correct": false },
    { "optionText": "Java uses indentation instead of braces to delimit code blocks.", "position": 3, "correct": false }
  ]
}

### 9. Create a StaticPage in Week 2 (expect 201)
# @name seedSpringPage
POST {{baseUrl}}/api/courses/{{courseId}}/modules/{{springModuleId}}/contents/pages
Content-Type: application/json

{
  "title": "Introduction to Spring Boot",
  "position": 0,
  "body": "Spring Boot makes it easier to create stand-alone Spring applications. In our LMS, controllers handle HTTP, services implement business rules, and repositories manage persistence."
}

# ---- READ TESTS: run after all nine POST requests above ----

### 10. Read the demo course (expect 200)
GET {{baseUrl}}/api/courses/{{courseId}}

### 11. Read both modules in position order (expect 200)
GET {{baseUrl}}/api/courses/{{courseId}}/modules

### 12. Week 1 content summaries (expect STATIC_PAGE then QUIZ, no body)
GET {{baseUrl}}/api/courses/{{courseId}}/modules/{{javaModuleId}}/contents

### 13. Week 1 StaticPage detail (expect 200, includes body)
GET {{baseUrl}}/api/contents/{{javaPageId}}

### 14. Read student-safe Quiz detail (expect 200, 3 ordered questions)
# VERY IMPORTANT: no 'correct' and no 'hint' in this response.
GET {{baseUrl}}/api/quizzes/{{quizId}}

### 15. Week 2 content summaries (expect 1 STATIC_PAGE)
GET {{baseUrl}}/api/courses/{{courseId}}/modules/{{springModuleId}}/contents

### 16. Week 2 StaticPage detail (expect 200)
GET {{baseUrl}}/api/contents/{{springPageId}}

### 17. Nonexistent quiz (expect 404)
GET {{baseUrl}}/api/quizzes/999999999

### 18. StaticPage ID is not a Quiz (expect 404)
GET {{baseUrl}}/api/quizzes/{{javaPageId}}


### Assignment

### Check existing Course
GET http://localhost:8080/api/courses/1

### Check existing Modules
GET http://localhost:8080/api/courses/1/modules
### 19. Create Assignment
# @name createWeek2Assignment
POST {{baseUrl}}/api/courses/{{assignmentCourseId}}/modules/{{assignmentModuleId}}/contents/assignments
Content-Type: application/json

{
  "title": "Spring Boot and JPA Assignment",
  "position": 1,
  "instructions": "Implement JPA entities and repositories. Submit a short report.",
  "deadline": "2026-11-20T23:00:00Z",
  "allowLateSubmission": false
}

### 20. Get Assignment
GET {{baseUrl}}/api/assignments/18

### 21. Get Week 2 Contents
GET {{baseUrl}}/api/courses/{{assignmentCourseId}}/modules/{{assignmentModuleId}}/contents

### 22. Nonexistent Assignment - expect 404
GET {{baseUrl}}/api/assignments/999999999

# ### 23. StaticPage is not Assignment - expect 404
# GET {{baseUrl}}/api/assignments/{{springPageId}}

