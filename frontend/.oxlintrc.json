{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@app/**", "@domain/**", "@features/**", "**/app/**", "**/domain/**", "**/features/**"],
                "message": "shared/ knows nothing about the app: it may not import from app/, domain/ or features/ (see README.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@app/**", "@features/**", "**/app/**", "**/features/**"],
                "message": "domain/ may not import from app/ or features/ (see README.md)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@app/**", "**/app/**"],
                "message": "features/ may not import from app/ (see README.md)."
              },
              {
                "group": ["@features/**"],
                "message": "A feature may not import another feature: move what both need to domain/ or shared/ (see README.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
